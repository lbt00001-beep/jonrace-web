  <Placemark>
    <name>Giro Este - Via Verde Colmenar</name>
    <description>Extremo noreste: aqui se da la vuelta y se toma el camino de tierra, dejando la via a la derecha.</description>
    <Point><coordinates>-3.68679,40.51494,0</coordinates></Point>
  </Placemark>
